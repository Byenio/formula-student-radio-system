# ==============================================================================
#  build_info.cmake -- writes build_info.h with the firmware's identity.
#
#  Run as a script (cmake -P) by a custom target on EVERY build, not at
#  configure time. A hash captured at configure time goes stale the moment
#  you commit without reconfiguring, and then every log claims to come from
#  firmware it did not come from. Running per build costs one `git describe`.
#
#  The header is only rewritten when its content changes, so an unchanged
#  tree does not trigger a recompile of stats.c on every build.
#
#  Deliberately NO build date or time: it would change on every build, defeat
#  the above, and make two builds of the same commit look different. The git
#  hash plus the -dirty flag is what identifies a build.
#
#  Inputs (-D): OUT, SRC_DIR, BUILD_TYPE, OPT_OVERRIDE
#  IDENTICAL ON BOTH BOARDS.
# ==============================================================================

execute_process(
        COMMAND git describe --always --dirty --abbrev=8
        WORKING_DIRECTORY ${SRC_DIR}
        OUTPUT_VARIABLE GIT_DESC
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
        RESULT_VARIABLE GIT_RESULT
)

if(NOT GIT_RESULT EQUAL 0 OR GIT_DESC STREQUAL "")
    set(GIT_DESC "nogit")
endif()

# A sweep build (-DFW_OPT_OVERRIDE=-O3) must never be mistaken for the real
# one in a log, so the override is part of the build type it reports.
set(TYPE "${BUILD_TYPE}")
if(OPT_OVERRIDE)
    set(TYPE "${TYPE}${OPT_OVERRIDE}")
endif()

set(CONTENT "/* Generated by cmake/build_info.cmake on every build. Do not edit. */
#ifndef BUILD_INFO_H
#define BUILD_INFO_H
#define FW_BUILD_GIT  \"${GIT_DESC}\"
#define FW_BUILD_TYPE \"${TYPE}\"
#endif
")

if(EXISTS "${OUT}")
    file(READ "${OUT}" OLD)
else()
    set(OLD "")
endif()

if(NOT OLD STREQUAL CONTENT)
    file(WRITE "${OUT}" "${CONTENT}")
endif()